# Prevent directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "\.(env|ini|log|sh|sql|bak|md)$">
    Require all denied
</FilesMatch>

# Block access to config directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
</IfModule>

# Block direct access to tiling price files
<IfModule mod_rewrite.c>
    RewriteRule ^users/tilings/.*\.txt$ - [F,L]
</IfModule>
